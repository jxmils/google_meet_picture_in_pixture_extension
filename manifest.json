{
  "manifest_version": 3,
  "name": "Meet Person Float",
  "version": "1.1.0",
  "description": "Choose one Google Meet participant for a movable, always-on-top video window.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Float a Google Meet participant",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "choose-person": {
      "suggested_key": {
        "default": "Alt+Shift+1",
        "mac": "Alt+Shift+1"
      },
      "description": "Open the Google Meet participant list"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "picker.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
